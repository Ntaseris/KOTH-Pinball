[sub_resource type="Shader" id="Shader_static"]
code = "shader_type canvas_item;\n\nfloat random(vec2 coordinate) {\n    return fract(sin(dot(coordinate, vec2(12.9898, 78.233))) * 43758.5453);\n}\n\nvoid fragment() {\n    vec2 cells = floor(UV * vec2(684.0, 384.0));\n    float snow = random(cells + floor(TIME * 45.0));\n    float scanline = sin((UV.y + TIME * 0.35) * 950.0) * 0.10;\n    float roll = smoothstep(0.018, 0.0, abs(fract(UV.y - TIME * 1.8) - 0.5));\n    float level = clamp(snow + scanline + roll * 0.45, 0.0, 1.0);\n    COLOR = vec4(vec3(level), 1.0);\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_static"]
shader = SubResource("Shader_static")

[sub_resource type="Animation" id="Animation_reset"]
length = 0.001
tracks/0/type = "value"
tracks/0/path = NodePath("StaticOverlay:modulate")
tracks/0/keys = {"times": PackedFloat32Array(0), "transitions": PackedFloat32Array(1), "update": 0, "values": [Color(1, 1, 1, 0)]}

[sub_resource type="Animation" id="Animation_channel_change"]
resource_name = "channel_change"
length = 0.42
tracks/0/type = "value"
tracks/0/path = NodePath("StaticOverlay:modulate")
tracks/0/keys = {"times": PackedFloat32Array(0, 0.08, 0.16, 0.27, 0.42), "transitions": PackedFloat32Array(1, 1, 1, 1, 1), "update": 0, "values": [Color(1, 1, 1, 1), Color(1, 1, 1, 0.9), Color(1, 1, 1, 0.65), Color(1, 1, 1, 0.22), Color(1, 1, 1, 0)]}

[sub_resource type="AnimationLibrary" id="AnimationLibrary_channel"]
_data = {&"RESET": SubResource("Animation_reset"), &"channel_change": SubResource("Animation_channel_change")}

